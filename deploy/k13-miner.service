# K-13 history miner (systemd user unit template): mirrors maincloud's public
# scrabblebot tables (anonymous, read-only) into data/miner.sqlite, derives
# observations, refits bid models hourly and pushes everything to the local
# k13 backend. Replace @K13_DIR@ and @NODE@ as in k13-bot.service.
[Unit]
Description=K-13 history miner (maincloud scrabblebot -> SQLite working copy -> k13 SpacetimeDB backend)
After=network-online.target k13-stdb.service
Wants=k13-stdb.service

[Service]
WorkingDirectory=@K13_DIR@
ExecStart=@NODE@ @K13_DIR@/node_modules/tsx/dist/cli.mjs src/memory/mine.ts --follow --db data/miner.sqlite
Restart=always
RestartSec=10
Nice=10
StandardOutput=append:@K13_DIR@/logs/miner.log
StandardError=append:@K13_DIR@/logs/miner.log

[Install]
WantedBy=default.target
